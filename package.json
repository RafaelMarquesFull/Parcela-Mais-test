{
  "name": "parcela-mais",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w backend & npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:watch": "npm run test:watch -w backend"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
